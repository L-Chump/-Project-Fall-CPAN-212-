html
  head
    title Edit Movie
    style.
      body { font-family: Arial; background: #f2f2f2; margin: 0; }
      header { background: #333; padding: 15px; }
      header h1 { color: white; margin: 0; }
      nav ul { list-style: none; display: flex; gap: 15px; padding: 0; }
      nav a { color: white; text-decoration: none; }
      main { padding: 20px; }
      input, textarea, button { padding: 10px; margin-top: 10px; width: 300px; }
  body
    header
      h1 Edit Movie
      nav
        ul
          li: a(href="/") Home
          li: a(href="/movies") Movies

    main
      form(method="POST")
        label Name:
        br
        input(type="text" name="name" value=movie.name)

        br
        label Description:
        br
        textarea(name="description")= movie.description

        br
        label Year:
        br
        input(type="number" name="year" value=movie.year)

        br
        label Genres:
        br
        input(type="text" name="genres" value=movie.genres.join(', '))

        br
        label Rating:
        br
        input(type="number" name="rating" min="0" max="10" value=movie.rating)

        br
        button(type="submit") Save Changes
