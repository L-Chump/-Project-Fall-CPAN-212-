html
  head
    title= movie.name
    style.
      body { font-family: Arial; background: #f2f2f2; margin: 0; }
      header { background: #333; padding: 15px; }
      header h1 { color: white; margin: 0; }
      nav ul { list-style: none; display: flex; gap: 15px; padding: 0; }
      nav a { color: white; text-decoration: none; }
      main { padding: 20px; }
      .button {
        padding: 10px 15px;
        background: #4caf50;
        color: white;
        text-decoration: none;
        border-radius: 4px;
      }
      .danger {
        background: #e53935;
      }
  body
    header
      h1= movie.name
      nav
        ul
          li: a(href="/movies") Back to Movies

    main
      p Description: #{movie.description}
      p Year: #{movie.year}
      p.small Genres: #{Array.isArray(movie.genres) ? movie.genres.join(', ') : movie.genres || 'N/A'} 
      p Rating: #{movie.rating}

      br

      a.button(href="/movies/" + movie._id + "/edit") Edit

      form(method="POST" action="/movies/" + movie._id + "/delete" style="display:inline;")
        button.danger(type="submit") Delete
