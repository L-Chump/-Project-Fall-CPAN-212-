extends layout
block content
  .card
    h2 #{movie.name} (#{movie.year})
    p.small Genres: #{movie.genres.join(', ')} | Rating: #{movie.rating || 'N/A'}
    p #{movie.description}
    if currentUser && movie.owner && currentUser._id == movie.owner
      a(href=`/movies/${movie._id}/edit`) Edit
      form#del(detail)(action=`/movies/${movie._id}/delete` method="post" style="display:inline")
        button(type="button" onclick=`confirmDelete('del(detail)')`) Delete
    hr
    // simple JS button to show "movie recipe" (we display JSON details)
    button(id="showRecipe") movie data (recipe)
    pre(id="recipe" style="display:none; background:#f6f6f6; padding:10px;")
      | #{JSON.stringify(movie, null, 2)}
    script.
      document.getElementById('showRecipe').addEventListener('click', function() {
        var pr = document.getElementById('recipe');
        pr.style.display = pr.style.display === 'none' ? 'block' : 'none';
      });
