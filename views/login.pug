extends layout
block content
  if errors
    ul.err
      each e in errors
        li #{e}
  form(action="/login" method="post")
    div
      label(for="username") Username:
      input(type="text" name="username" id="username")
    div
      label(for="password") Password:
      input(type="password" name="password" id="password")
    div
      button(type="submit") Login

